#!/bin/sh
# This file has been created with the assistance of an AI tool.
#
# agent-wrap: provisions the pinned CPython this wrapper runs on, and the venv
# holding its locked dependencies.
#
# The wrapper does not use the host's python3 -- bin/agent execs an interpreter
# this script installs, so the pinned version is the only one the CLI ever runs
# on. Deliberately POSIX sh with no Python of its own: it is what makes the host
# requirement "curl + tar + a SHA-256 tool" instead of "some Python, we hope".
#
# Layout under <wrap_dir>/.python (gitignored):
#   cpython-<ver>+<rel>-<target>/       an extracted, hash-verified interpreter
#   venv-<ver>+<rel>-<target>-<req12>/  a venv holding bin/requirements.txt
#   venv-<ver>+<rel>-<target>-dev/      a venv holding uv.lock, prod + dev (--dev)
#   current                             one line: the interpreter slug
#   current-venv                        one line: the venv bin/agent should exec
#
# Except under --dev (below), the venv is named for the interpreter pin AND the
# SHA-256 of the constraints file it was built from, so a dependency change
# produces a new directory rather than mutating the live one. That is what makes
# `agent update` safe: the swap is a single atomic rename of `current-venv`.
#
# Both pointers are plain text files rather than symlinks on purpose. Replacing a
# symlink-to-directory in POSIX sh is not portable -- `mv -f newlink oldlink`
# moves the new link *inside* the target directory on both GNU and BSD, and the
# fix (`mv -T`) does not exist on macOS. `mv tmp current` onto a regular file is
# a true atomic rename(2) everywhere.
#
# Nothing on that path is ever mutated in place and nothing is ever pruned: a logs
# daemon started under an older interpreter keeps running from its own tree. To
# reclaim the space, remove the whole tree and re-run:
#   rm -rf .python && bin/agent-bootstrap
#
# Without --dev, dev tooling is NOT installed: the default build is exactly the
# runtime the shipped CLI needs, installed by pip from the hash-pinned constraints,
# and it requires no uv. That is the path end users get and the one `agent update`
# re-provisions with.
#
# --dev is the contributor build (`make install`), and it hands the whole dependency
# question to `uv sync --locked`, which installs the prod dependencies AND the dev
# group out of uv.lock -- the same lock bin/requirements.txt is exported from. So the
# pip step above is skipped entirely rather than run first and then synced over.
# Its venv is named for the interpreter alone, with no content hash: what a hash
# would gate, `uv sync` decides for itself on every run, including a dev-group bump
# that left bin/requirements.txt untouched. That also means this one venv is synced
# in place rather than published under a new name -- the atomic-swap guarantee below
# is for the venvs `agent` itself runs on, and nothing on that path passes --dev.
#
# Usage: agent-bootstrap [--force] [--dev]
#   --force  provision even when the pin is already satisfied
#   --dev    sync prod + dev dependencies from uv.lock instead of installing
#            bin/requirements.txt. Requires uv, plus pyproject.toml and uv.lock
#            beside this script.
#
# Env:
#   AGENT_PYTHON_TARBALL  use a pre-staged archive instead of downloading. Still
#                         verified against the pin's SHA-256, so this is a
#                         staging path for air-gapped hosts, not a way around
#                         the pin. For the dependency half, pip reads PIP_NO_INDEX
#                         and PIP_FIND_LINKS natively -- point them at a local
#                         wheelhouse and no wrapper code is involved. Under --dev
#                         it is uv that fetches, so uv's own variables (UV_INDEX,
#                         UV_OFFLINE, UV_FIND_LINKS) are the equivalent there.

set -eu

BASE_URL=https://github.com/astral-sh/python-build-standalone/releases/download

die() {
    printf 'agent-bootstrap: %s\n' "$*" >&2
    exit 1
}

note() {
    printf 'agent-bootstrap: %s\n' "$*"
}

# Resolve this script's real path, following symlinks. Kept deliberately
# identical to the loop in bin/agent -- change one, change the other.
src="$0"
while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in
        /*) ;;
        *) src="$dir/$src" ;;
    esac
done
bin_dir=$(cd -P "$(dirname "$src")" && pwd)
wrap_dir=$(dirname "$bin_dir")

force=0
dev=0
# Not overridable. Every caller -- the host, CI, and the dev container, whose own tree
# shadows the host's at the same path -- provisions into the checkout's own .python/,
# which is what lets bin/agent and the Makefile name one relative path everywhere.
prefix="$wrap_dir/.python"
while [ $# -gt 0 ]; do
    case "$1" in
        --force) force=1 ;;
        --dev) dev=1 ;;
        -h|--help)
            # Addressed by marker, not by line number: the help text is the header's
            # own Usage/Env block, and a line range would silently drift every time
            # that block is edited.
            sed -n '/^# Usage:/,/^$/p' "$src" | sed -e 's/^#$//' -e 's/^# //'
            exit 0
            ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

[ -f "$wrap_dir/python-pin.env" ] || die "missing pin file: $wrap_dir/python-pin.env"
# shellcheck disable=SC1091
. "$wrap_dir/python-pin.env"
[ -n "${AGENT_PY_VERSION:-}" ] || die "python-pin.env sets no AGENT_PY_VERSION"
[ -n "${AGENT_PY_RELEASE:-}" ] || die "python-pin.env sets no AGENT_PY_RELEASE"

# --dev's preconditions, checked here rather than where uv is called: everything
# between is a 34MB download and an archive extraction, and none of it is worth doing
# for a run that cannot finish. The default path deliberately checks none of this --
# it must stay runnable on a host that has never heard of uv.
if [ "$dev" -eq 1 ]; then
    command -v uv >/dev/null 2>&1 \
        || die "--dev needs uv on PATH (see docs/getting-started.md)"
    [ -f "$wrap_dir/pyproject.toml" ] || die "missing project file: $wrap_dir/pyproject.toml"
    [ -f "$wrap_dir/uv.lock" ] || die "missing lock file: $wrap_dir/uv.lock"
fi

# --- target resolution ------------------------------------------------------
# The arch name is per-OS, not universal: Linux reports aarch64 where macOS
# reports arm64, and both map to the same python-build-standalone target.
os=$(uname -s)
machine=$(uname -m)
case "$os" in
    Linux)
        platform=unknown-linux-gnu
        # python-build-standalone's -unknown-linux-gnu builds are glibc-linked.
        # On musl they fail to exec with a bewildering "not found", so say so.
        for loader in /lib/ld-musl-*; do
            [ -e "$loader" ] && die "musl libc detected ($loader); only glibc hosts are supported"
            break
        done
        ;;
    Darwin) platform=apple-darwin ;;
    *) die "unsupported OS: $os (supported: Linux, Darwin)" ;;
esac
case "$machine" in
    x86_64|amd64) cpu=x86_64 ;;
    aarch64|arm64) cpu=aarch64 ;;
    *) die "unsupported architecture: $machine (supported: x86_64, aarch64/arm64)" ;;
esac
target="$cpu-$platform"

slug="cpython-$AGENT_PY_VERSION+$AGENT_PY_RELEASE-$target"
asset="$slug-install_only_stripped.tar.gz"
tree="$prefix/$slug"

sha_var="SHA256_$(printf '%s' "$target" | tr - _)"
eval "want_sha=\${$sha_var:-}"
[ -n "$want_sha" ] || die "python-pin.env carries no hash for $target ($sha_var)"

# --- tool probes ------------------------------------------------------------
# Above pin_satisfied, not below it: the fast path now hashes the constraints file,
# so sha256_of has to exist before the first check. The extra cost is one fork on a
# small text file. bin/agent never calls this script, so nothing on the TAB-completion
# path pays for it.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | sed 's/.*= *//'
    else
        die "no SHA-256 tool found (need sha256sum, shasum or openssl)"
    fi
}

fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 3 -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$2" "$1"
    else
        die "no downloader found (need curl or wget)"
    fi
}

command -v tar >/dev/null 2>&1 || die "tar not found"

# --- venv identity ----------------------------------------------------------
# Content-addressed by the constraints file. A dependency change lands as a new
# directory, so the previous venv stays intact and usable until the pointer moves.
#
# The dev venv is the exception, and deliberately: its contents come from uv.lock,
# which `uv sync` reconciles against on every run, so a hash here would gate nothing
# and only strand a directory per lock revision. The constraints file is not read at
# all under --dev -- it is neither installed nor hashed -- so it is not required either.
if [ "$dev" -eq 1 ]; then
    venv_slug="venv-$AGENT_PY_VERSION+$AGENT_PY_RELEASE-$target-dev"
else
    req_file="$wrap_dir/bin/requirements.txt"
    [ -f "$req_file" ] || die "missing constraints file: $req_file"
    req12=$(sha256_of "$req_file" | cut -c1-12)
    venv_slug="venv-$AGENT_PY_VERSION+$AGENT_PY_RELEASE-$target-$req12"
fi
venv="$prefix/$venv_slug"

# Already satisfied? Checked twice: once before taking the lock, so the common case
# costs a couple of stats and no network, and again after acquiring it, so a process
# that queued behind a concurrent bootstrap does not redo the work that bootstrap
# just finished.
pin_satisfied() {
    [ "$force" -eq 0 ] || return 1
    # Never satisfied under --dev: the dev slug carries no content hash, so this
    # function cannot tell whether the venv matches uv.lock -- only `uv sync` can, and
    # it has to be reached to say so. The interpreter half of the run is still skipped
    # by the guards below, so the cost of a no-op --dev is one uv sync and no network.
    [ "$dev" -eq 0 ] || return 1
    [ -x "$tree/bin/python3" ] || return 1
    [ -f "$prefix/current" ] || return 1
    read -r installed < "$prefix/current" || return 1
    [ "$installed" = "$slug" ] || return 1
    [ -x "$venv/bin/python3" ] || return 1
    [ -f "$prefix/current-venv" ] || return 1
    read -r installed_venv < "$prefix/current-venv" || return 1
    [ "$installed_venv" = "$venv_slug" ] || return 1
    return 0
}

if pin_satisfied; then
    exit 0
fi

# --- lock -------------------------------------------------------------------
# mkdir, not flock: macOS ships no flock(1). The pid file is what makes a lock
# left behind by a SIGKILL recoverable -- the startup-script path can kill this
# script's whole process group, and a lock nobody can break would wedge every
# future bootstrap on the host.
mkdir -p "$prefix"
lock="$prefix/.lock"
waited=0
while ! mkdir "$lock" 2>/dev/null; do
    owner=$(cat "$lock/pid" 2>/dev/null || echo "")
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
        [ "$waited" -eq 0 ] && note "waiting for another bootstrap (pid $owner)"
        waited=$((waited + 1))
        [ "$waited" -lt 600 ] || die "bootstrap pid $owner has held the lock for 10 minutes"
        sleep 1
    else
        note "removing a stale lock left by pid ${owner:-unknown}"
        rm -rf "$lock"
    fi
done
printf '%s\n' "$$" > "$lock/pid"

if pin_satisfied; then
    rm -rf "$lock"
    exit 0
fi

tmp="$prefix/.tmp.$$"
cleanup() {
    rm -rf "$tmp" "$lock"
}
trap cleanup EXIT INT TERM HUP
mkdir -p "$tmp"

# --- fetch, verify, extract ---------------------------------------------------
# All three are skipped when the tree is already in place, because pin_satisfied now
# also fails for a constraints-only change -- and re-downloading 34MB of CPython to
# rebuild a venv would be a pointless tax on every dependency bump.
#
# Unpack beside the destination and rename, so a partially written tree is
# never visible under its final name. The archive's top level is `python/`.
extracted=0
if [ ! -x "$tree/bin/python3" ]; then
    if [ -n "${AGENT_PYTHON_TARBALL:-}" ]; then
        [ -f "$AGENT_PYTHON_TARBALL" ] || die "AGENT_PYTHON_TARBALL is not a file: $AGENT_PYTHON_TARBALL"
        tarball="$AGENT_PYTHON_TARBALL"
        note "using staged archive $tarball"
    else
        tarball="$tmp/$asset"
        note "downloading CPython $AGENT_PY_VERSION for $target"
        fetch "$BASE_URL/$AGENT_PY_RELEASE/$asset" "$tarball"
    fi

    got_sha=$(sha256_of "$tarball")
    if [ "$got_sha" != "$want_sha" ]; then
        die "SHA-256 mismatch for $asset
  expected $want_sha
  got      $got_sha"
    fi

    rm -rf "$tree"
    tar -xzf "$tarball" -C "$tmp"
    [ -x "$tmp/python/bin/python3" ] || die "$asset did not contain python/bin/python3"
    mv "$tmp/python" "$tree"
    extracted=1
fi
"$tree/bin/python3" -c 'import sys; sys.exit(0)' \
    || die "the extracted interpreter does not run on this host"

# --- publish the interpreter -------------------------------------------------
# Before the venv, deliberately. This pointer says which tree is verified and in
# place; the venv below is built against it and published separately. Written
# unconditionally -- it is cheap, and it repairs a pointer lost while its tree survived.
#
# The note is not unconditional, because reaching here does not mean anything was
# installed. A constraints-only bump reuses the tree, and --dev reaches here on every
# run by design, so announcing an interpreter that was already in place would make the
# common case read like work. Only an actual extraction says so.
printf '%s\n' "$slug" > "$tmp/current"
mv "$tmp/current" "$prefix/current"
[ "$extracted" -eq 0 ] || note "CPython $AGENT_PY_VERSION ready at $tree"

# --- dependencies -------------------------------------------------------------
# Built under $tmp and renamed, so a partially installed venv is never visible under
# its final name. Only the exported constraints are installed -- never the project
# itself, which would put a second copy of agent_wrap in site-packages for PYTHONPATH
# to shadow. --require-hashes makes the hashes in the constraints file a hard gate
# rather than a side effect of them happening to be present, matching how the
# interpreter tarball is verified above.
#
# --dev takes the other branch and neither stages nor renames. Its venv name is stable,
# so there is no new directory to publish -- the venv is created once and re-entered,
# and `uv sync` is what makes its contents match the lock. Nothing to repoint either:
# uv writes its console scripts at the venv's final path from the start.
if [ "$dev" -eq 1 ]; then
    note "syncing prod + dev dependencies from uv.lock"
    # The venv must exist, and be this interpreter's, before uv runs: handed an existing
    # environment uv adopts it, but handed an empty path it would resolve an interpreter
    # of its own choosing and the pin would stop meaning anything. UV_PROJECT_ENVIRONMENT
    # is what stops it creating a .venv beside pyproject.toml instead, and
    # `package = false` there is what stops it installing agent_wrap into site-packages,
    # where it would shadow the copy PYTHONPATH provides.
    [ -x "$venv/bin/python3" ] || "$tree/bin/python3" -m venv "$venv"
    UV_PROJECT_ENVIRONMENT="$venv" uv sync --locked --project "$wrap_dir"
elif [ ! -x "$venv/bin/python3" ]; then
    note "installing dependencies from bin/requirements.txt"
    rm -rf "$tmp/venv"
    "$tree/bin/python3" -m venv "$tmp/venv"
    "$tmp/venv/bin/python3" -m pip install \
        -r "$req_file" \
        --require-hashes \
        --only-binary=:all: \
        --disable-pip-version-check \
        --quiet
    # pip bakes the interpreter's absolute path into the shebang of every console
    # script it writes, and this venv is built under $tmp -- so any such script would
    # land pointing at a directory this script is about to delete. Repointing them
    # happens here, before the rename, to keep the invariant that nothing half-finished
    # is ever visible under the final name. `sed -i` is out: BSD sed requires an
    # argument to it and GNU sed forbids one.
    for script in "$tmp"/venv/bin/*; do
        [ -f "$script" ] || continue
        IFS= read -r shebang < "$script" || continue
        case $shebang in "#!$tmp/venv/bin/"*) ;; *) continue ;; esac
        # cp first, then truncate it by redirection: that carries the executable
        # bit over without a chmod that a umask could water down.
        cp -p "$script" "$script.repointed"
        sed "1s|^#!$tmp/venv/bin/|#!$venv/bin/|" "$script" > "$script.repointed"
        mv "$script.repointed" "$script"
    done
    # Only reachable for a venv left behind by an interrupted run: a published one
    # is never rebuilt, because its name encodes the constraints it was built from.
    rm -rf "$venv"
    mv "$tmp/venv" "$venv"
fi

# --- publish the venv ---------------------------------------------------------
# Last, and atomically. Until this rename lands, `current-venv` still names the
# previous venv -- so a failed dependency install leaves the CLI running on the old
# dependency set rather than leaving it with none at all. On a first-ever run there
# is no previous pointer and bin/agent says the wrapper is not provisioned, which is
# the correct answer.
printf '%s\n' "$venv_slug" > "$tmp/current-venv"
mv "$tmp/current-venv" "$prefix/current-venv"
note "dependencies ready at $venv"
