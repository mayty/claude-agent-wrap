#!/bin/sh
# This file has been created with the assistance of an AI tool.
#
# agent-wrap: the `agent` launcher. POSIX sh, so it works under any caller shell.
#
# The interpreter is the venv bin/agent-bootstrap provisions, addressed by path. There is
# deliberately no fallback to the host's python3: a fallback is a floor in disguise.
#
# A missing venv is bootstrapped here rather than reported: the bootstrap is
# non-interactive, idempotent and self-serialising, so there is nothing to decide. Shell
# completion is the one exception, for the reason below.

# Resolve this script's real path, following symlinks (portable; readlink -f
# is unavailable on some platforms).
src="$0"
while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in
        /*) ;;
        *) src="$dir/$src" ;;
    esac
done
bin_dir=$(cd -P "$(dirname "$src")" && pwd)
wrap_dir=$(dirname "$bin_dir")

# `current-venv` names the venv directory to use; see bin/agent-bootstrap for why it is a
# text file and not a symlink. `read` is a builtin, so the completion path -- which runs
# on every TAB -- pays no fork. The [ -f ] guard keeps the shell from writing its own
# "cannot open" line to stderr.
#
# A function because it runs twice: before a bootstrap, and again after one.
py_root="$wrap_dir/.python"
resolve_venv() {
    venv_slug=""
    [ -f "$py_root/current-venv" ] && read -r venv_slug < "$py_root/current-venv"
    py="$py_root/$venv_slug/bin/python3"
}

resolve_venv

if [ -z "$venv_slug" ] || [ ! -x "$py" ]; then
    # Completion must stay silent: anything on stdout is parsed by click's completion
    # function as a `type,value` candidate line. It does not provision either -- a TAB
    # press is no place to spend a 34MB download whose progress the shell would swallow.
    [ -n "${_AGENT_COMPLETE:-}" ] && exit 0

    # The bootstrap says what it is doing; this says why it is happening at all.
    printf '%s\n' \
        "agent-wrap: not provisioned (first run, or the checkout moved); provisioning now." >&2

    # Plain, never --dev: --dev needs uv on PATH, and this is the end-user path.
    #
    # The redirection is load-bearing: this script's stdout belongs to the verb about to
    # be exec'd, and anything parsing it must not have to filter provisioning chatter out.
    #
    # `if !` rather than comparing $? to 1: the bootstrap runs under `set -e`, so an
    # unguarded failure surfaces *that* command's status.
    if ! "$bin_dir/agent-bootstrap" >&2; then
        # For a non-interactive caller this is the only thing anyone will see, so it
        # names the absolute path of the one command to re-run by hand.
        printf '%s\n' \
            "agent-wrap: provisioning failed." \
            "Run: $bin_dir/agent-bootstrap" >&2
        exit 1
    fi

    # `current-venv` is published last and atomically, so re-reading it turns "the
    # bootstrap exited 0" into "there is an interpreter here to exec".
    resolve_venv
    if [ -z "$venv_slug" ] || [ ! -x "$py" ]; then
        printf '%s\n' \
            "agent-wrap: still not provisioned after running the bootstrap." \
            "Run: $bin_dir/agent-bootstrap" >&2
        exit 1
    fi
fi

exec env PYTHONPATH="$wrap_dir" "$py" -m agent_wrap "$@"
