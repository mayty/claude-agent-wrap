#!/usr/bin/env bash
# This file has been edited with the assistance of an AI tool.
#
# Validates a project Dockerfile against the agent-wrap contract BEFORE the
# user is asked to rebuild. Catches the failure modes that `docker build`
# cannot surface on its own:
#
#   1. hadolint — generic Dockerfile hygiene.
#   2. Wrapper contract checks — agent-name format, WORKDIR, agent-run-args
#      quoting, agent-enable-startup value, HOST_UID/GID declarations.
#   3. Base image — the final FROM must be the wrapper's `claude-agent`, and
#      the expected in-container user must exist in it, so a successful build
#      can't produce an image that fails at launch time.
#
# Usage: validate-dockerfile-agent [path/to/Dockerfile]
#
# With no argument, .claude-agent-wrap/Dockerfile is validated, falling back to
# the deprecated ./Dockerfile.agent.
#
# Exit codes:
#   0 — validation passed (warnings allowed)
#   1 — validation failed (one or more errors)
#   2 — usage / file-not-found

set -uo pipefail

ASSETS_DIR=".claude-agent-wrap"
CURRENT_DOCKERFILE="$ASSETS_DIR/Dockerfile"
LEGACY_DOCKERFILE="Dockerfile.agent"
STARTUP_SCRIPT="$ASSETS_DIR/startup.sh"

is_legacy=0
if [ "$#" -gt 0 ]; then
    DOCKERFILE="$1"
    [ "$(basename "$DOCKERFILE")" = "$LEGACY_DOCKERFILE" ] && is_legacy=1
elif [ -f "$CURRENT_DOCKERFILE" ] && [ -f "$LEGACY_DOCKERFILE" ]; then
    echo "validate-dockerfile-agent: both '$CURRENT_DOCKERFILE' and legacy" >&2
    echo "  '$LEGACY_DOCKERFILE' exist — delete '$LEGACY_DOCKERFILE'" >&2
    exit 2
elif [ -f "$CURRENT_DOCKERFILE" ]; then
    DOCKERFILE="$CURRENT_DOCKERFILE"
elif [ -f "$LEGACY_DOCKERFILE" ]; then
    DOCKERFILE="$LEGACY_DOCKERFILE"
    is_legacy=1
else
    echo "validate-dockerfile-agent: no '$CURRENT_DOCKERFILE' in $(pwd)" >&2
    exit 2
fi

if [ ! -f "$DOCKERFILE" ]; then
    echo "validate-dockerfile-agent: '$DOCKERFILE' not found" >&2
    exit 2
fi

errors=0
warnings=0

err()  { echo "ERROR: $*" >&2; errors=$((errors+1)); }
warn() { echo "WARN:  $*" >&2; warnings=$((warnings+1)); }
info() { echo "INFO:  $*" >&2; }

if [ "$is_legacy" -eq 1 ]; then
    warn "'$LEGACY_DOCKERFILE' is deprecated — move it to '$CURRENT_DOCKERFILE'"
fi

# ---------------------------------------------------------------------------
# 1. Generic Dockerfile lint (hadolint)
# ---------------------------------------------------------------------------
if command -v hadolint >/dev/null 2>&1; then
    info "Running hadolint on $DOCKERFILE"
    # DL3008 (pin apt versions) and DL3013 (pin pip versions) are noisy for
    # the short-lived per-developer images this wrapper produces. DL3006
    # (tag base images) fires on the recommended `FROM claude-agent` form,
    # which is intentionally untagged because the base is a locally built
    # image, not a registry-hosted one.
    if ! hadolint --ignore DL3006 --ignore DL3008 --ignore DL3013 "$DOCKERFILE"; then
        warn "hadolint reported issues (above)"
    fi
else
    info "hadolint not installed; skipping generic Dockerfile lint"
fi

# ---------------------------------------------------------------------------
# 2. Wrapper-contract checks
# ---------------------------------------------------------------------------

# --- # agent-name: required, matches [a-z0-9_.-]+
name=$(grep -oE '^#[[:space:]]*agent-name:[[:space:]]*\S+' "$DOCKERFILE" \
       | head -n1 | sed -E 's/^#[[:space:]]*agent-name:[[:space:]]*//')
if [ -z "$name" ]; then
    err "missing '# agent-name: <name>' directive"
elif ! [[ "$name" =~ ^[a-z0-9_.-]+$ ]]; then
    err "agent-name '$name' must match [a-z0-9_.-]+ (Docker image names are lowercase)"
elif [ "$name" = "workspace" ]; then
    err "agent-name 'workspace' is the in-container mount path, not a project name — set this to the host project directory name (available inside the container as \$AGENT_NAME)"
fi

# --- WORKDIR must stay at /workspace (last WORKDIR wins)
workdir=$(grep -iE '^WORKDIR[[:space:]]+' "$DOCKERFILE" \
          | tail -n1 | awk '{print $2}')
if [ -n "$workdir" ] && [ "$workdir" != "/workspace" ]; then
    err "WORKDIR is '$workdir' but the wrapper mounts the project at /workspace — set 'WORKDIR /workspace'"
fi

# --- # agent-user: what the wrapper will expect as $HOME inside the container
declared_user=$(grep -E '^#[[:space:]]*agent-user:[[:space:]]*\S+' "$DOCKERFILE" \
                | head -n1 | sed -E 's/^#[[:space:]]*agent-user:[[:space:]]*//')
expected_user="${declared_user:-ubuntu}"

# --- # agent-run-args: quoted whitespace is silently dropped
while IFS= read -r line; do
    [ -z "$line" ] && continue
    if echo "$line" | grep -qE "'[^']*[[:space:]][^']*'|\"[^\"]*[[:space:]][^\"]*\""; then
        warn "agent-run-args line contains quoted whitespace: '$line' — the wrapper whitespace-splits tokens, so quoting is ignored and the argument will be split."
    fi
done < <(grep -E '^#[[:space:]]*agent-run-args:[[:space:]]*.*' "$DOCKERFILE" \
         | sed -E 's/^#[[:space:]]*agent-run-args:[[:space:]]*//')

# --- HOST_UID / HOST_GID must be declared if referenced
if grep -qE '\$\{?HOST_UID\}?' "$DOCKERFILE" \
   && ! grep -qE '^ARG[[:space:]]+HOST_UID' "$DOCKERFILE"; then
    warn "HOST_UID is referenced but 'ARG HOST_UID' is not declared — the value will be empty at build time"
fi
if grep -qE '\$\{?HOST_GID\}?' "$DOCKERFILE" \
   && ! grep -qE '^ARG[[:space:]]+HOST_GID' "$DOCKERFILE"; then
    warn "HOST_GID is referenced but 'ARG HOST_GID' is not declared — the value will be empty at build time"
fi

# --- # agent-enable-startup: new location only, boolean word or positive seconds
startup_raw=$(grep -oE '^#[[:space:]]*agent-enable-startup:[[:space:]]*\S+' "$DOCKERFILE" \
              | head -n1 | sed -E 's/^#[[:space:]]*agent-enable-startup:[[:space:]]*//')
startup_enabled=0
if [ -n "$startup_raw" ]; then
    startup_value=$(echo "$startup_raw" | tr '[:upper:]' '[:lower:]')
    if [ "$is_legacy" -eq 1 ]; then
        err "'# agent-enable-startup:' is only supported in '$CURRENT_DOCKERFILE' — move '$LEGACY_DOCKERFILE' there to use a startup script"
    fi
    case "$startup_value" in
        true|yes|on)
            startup_enabled=1
            ;;
        false|no|off)
            ;;
        0)
            err "agent-enable-startup value '0' is not a timeout — write 'false' to disable startup scripts"
            ;;
        1)
            startup_enabled=1
            warn "agent-enable-startup value '1' reads as a boolean but is parsed as a 1-second timeout — write 'true' for the default budget"
            ;;
        *)
            if [[ "$startup_value" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
                startup_enabled=1
            else
                err "agent-enable-startup value '$startup_raw' is not understood — use 'true'/'false' or a positive number of seconds"
            fi
            ;;
    esac
fi

# --- the script and the directive must agree, or nothing happens at launch
if [ "$startup_enabled" -eq 1 ] && [ ! -f "$STARTUP_SCRIPT" ]; then
    warn "agent-enable-startup is on but '$STARTUP_SCRIPT' does not exist"
fi
if [ "$startup_enabled" -eq 0 ] && [ -f "$STARTUP_SCRIPT" ]; then
    if [ "$is_legacy" -eq 1 ]; then
        warn "'$STARTUP_SCRIPT' exists but startup scripts need '# agent-enable-startup: true' in '$CURRENT_DOCKERFILE' — move '$LEGACY_DOCKERFILE' there to use it"
    else
        warn "'$STARTUP_SCRIPT' exists but is not enabled — add '# agent-enable-startup: true' to '$DOCKERFILE'"
    fi
fi
if [ -f "$STARTUP_SCRIPT" ] && ! head -c 2 "$STARTUP_SCRIPT" | grep -q '^#!'; then
    info "'$STARTUP_SCRIPT' has no shebang; it will run under /bin/sh (add '#!/usr/bin/env bash' for bash features)"
fi

# ---------------------------------------------------------------------------
# 3. Base image and its user
#
# The *last* FROM (final stage) is what the tag ends up containing, so it is
# the one that must be `claude-agent`: the wrapper stamps the base image's id
# onto every project image and rebuilds when the two diverge, which is only
# answerable for an image that actually inherits from the base. Earlier stages
# of a multi-stage build may use any image at all.
#
# The user is then checked against what the base provides — even when this file
# has useradd/adduser steps, because the directive and the useradd target can
# disagree (e.g. '# agent-user: alice' + 'RUN adduser bob'), and that mismatch
# produces a broken image that the wrapper still can't launch.
#
# Resolution:
#   - final FROM is not claude-agent            → error.
#   - expected user is 'ubuntu'                 → pass (info).
#   - another user, but a useradd/adduser step
#     creates it                                → warn (agent should
#                                                  double-check the
#                                                  useradd spelling/flags).
#   - another user, not created by this file    → error.
# ---------------------------------------------------------------------------
base_image=$(grep -iE '^FROM[[:space:]]+' "$DOCKERFILE" \
             | tail -n1 | awk '{print $2}')

# The base is a locally built image, so there is no registry to probe. The
# wrapper owns the base Dockerfile and bakes in user 'ubuntu', so we hardcode
# that fact here. If the base ever switches users, this branch updates in the
# same change as the base Dockerfile.
is_local_base=0
if [[ "$base_image" =~ ^claude-agent(:.*)?$ ]]; then
    is_local_base=1
fi

# Extract usernames created by useradd/adduser in this Dockerfile.agent.
# The name is usually the last non-flag argument to the command, so split
# each invocation at shell operators (&&, ||, ;) and take $NF. Imperfect,
# but good enough for the common forms:
#   useradd -m alice
#   adduser -D bob
#   adduser --uid 1000 -h /home/x charlie
created_users=$(grep -oE '(useradd|adduser)[^&|;]*' "$DOCKERFILE" \
                | awk '{print $NF}' \
                | grep -vE '^(-|useradd|adduser)$' \
                | sort -u)
expected_is_created=0
if echo "$created_users" | grep -qxF "$expected_user"; then
    expected_is_created=1
fi

if [ -z "$base_image" ]; then
    err "no FROM directive found"
elif [ "$is_local_base" = "1" ]; then
    if [ "$expected_user" = "ubuntu" ]; then
        info "Base is local image '$base_image'; assuming user 'ubuntu' (built into the wrapper's base Dockerfile)"
    elif [ "$expected_is_created" = "1" ]; then
        warn "Base 'claude-agent' provides user 'ubuntu' only, but '# agent-user: $expected_user' was set; a useradd/adduser step in this Dockerfile.agent appears to create it — double-check the command actually produces a login user named '$expected_user' with a writable /home/$expected_user."
    else
        err "Base 'claude-agent' provides user 'ubuntu' only, but '# agent-user: $expected_user' was set. Add a 'RUN useradd $expected_user' step in this Dockerfile.agent or remove the agent-user directive."
    fi
else
    err "final FROM is '$base_image', but a project image must inherit from the wrapper's base image. Change the last FROM to 'FROM claude-agent' (earlier stages of a multi-stage build may use any image)."
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo
echo "Declared agent-name:  ${name:-<unset>}"
echo "Declared agent-user:  ${declared_user:-<unset, defaults to ubuntu>}"
echo "Base image (FROM):    ${base_image:-<none>}"
echo "Startup script:       $([ "$startup_enabled" -eq 1 ] && echo "enabled (${startup_raw})" || echo "disabled")"
echo "Wrapper expects HOME=/home/${expected_user} inside the container."
echo

if [ "$errors" -gt 0 ]; then
    echo "Validation failed: $errors error(s), $warnings warning(s)" >&2
    exit 1
fi
echo "Validation passed${warnings:+ with $warnings warning(s)}"
exit 0
