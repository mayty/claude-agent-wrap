# This file has been created with the assistance of an AI tool.
#
# The pinned CPython. Sourced by bin/agent-bootstrap (POSIX sh) and read by the
# Makefile's python-check target -- so it must stay plain KEY=value with no
# expansion, no quoting and no shell constructs.
#
# Bumping the pin: pick a python-build-standalone release, then take the four
# hashes from that release's SHA256SUMS asset:
#   https://github.com/astral-sh/python-build-standalone/releases/download/<tag>/SHA256SUMS
# requires-python in pyproject.toml pins the same exact version and must be
# bumped in the same change -- make python-check fails when the two disagree.

AGENT_PY_VERSION=3.14.7
AGENT_PY_RELEASE=20260825

# One per supported target, keyed by the python-build-standalone target triple
# with - replaced by _ so the name is a valid shell variable.
SHA256_x86_64_unknown_linux_gnu=a0f39e822fd3b96a2605f30f954acf9a2cdf91faa1385a13e24bc407a41e05ea
SHA256_aarch64_unknown_linux_gnu=7f0b801b0ba2c74531cd2e66ee898569cdf1f323a24383576f2a6761001e01f1
SHA256_x86_64_apple_darwin=1b1e977f6d4fb887c7fa662a8e33f18dfdc9b9cdfaf5cdb003f13b3317947848
SHA256_aarch64_apple_darwin=17ecb3d29c49765856370cbb47d948a24ec518be40f607362c1bbb3ebbc5c442
